# Local development defaults
NODE_ENV=development
PORT=5174
API_BIND=127.0.0.1
POSTGRES_BIND=127.0.0.1
USE_SEEDED_PROVIDERS=true
ENABLE_OPS_PANEL=false

# Optional persistence
DATABASE_URL=
ROUTE_STORE_PATH=data/route-store.json
POI_CACHE_PATH=data/montreal-pois.json

# Optional live map and routing providers
# MAPTILER_API_KEY is exposed to browser clients. Use a browser-restricted key.
MAPTILER_API_KEY=
GEOAPIFY_API_KEY=
MAPBOX_ACCESS_TOKEN=

# Public endpoint rate limits
ROUTE_GENERATION_RATE_LIMIT_MAX=30
ROUTE_GENERATION_RATE_LIMIT_WINDOW_MS=60000
GEOCODE_RATE_LIMIT_MAX=60
GEOCODE_RATE_LIMIT_WINDOW_MS=60000

# Required only for operator/debug endpoints
ADMIN_TOKEN=
