{
  "name": "meaningful-routes",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "bridge:codex": "tsx tools/chatgpt-codex-bridge/server.ts",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "validate:data": "tsx scripts/validate-data.ts",
    "validate:routes": "tsx scripts/validate-routes.ts",
    "validate:media": "tsx scripts/validate-media.ts",
    "sync:pois": "tsx scripts/sync-pois.ts --city montreal",
    "sync:routes": "tsx scripts/sync-routes.ts --city montreal",
    "test": "vitest run",
    "test:smoke": "playwright test --config=playwright.config.ts tests/playwright-smoke.pw.ts"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^5.24.0",
    "next": "15.3.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.3.9",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.22.4",
    "typescript": "^5.8.3",
    "vitest": "^2.1.8"
